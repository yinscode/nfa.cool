# Read-only testnet probes and later development configuration.
NEAR_RPC_URL=https://test.rpc.fastnear.com
NEAR_SIGNER_ACCOUNT_ID=v1.signer-prod.testnet
# Set after deploying the project; no credentials belong in this file.
NFA_REGISTRY_ID=nfagent-registry-0e9b2a.testnet
NFA_PORT=3102
NFA_DATA_DIR=.data
# Public deployment (single Node instance behind HTTPS):
# NODE_ENV=production
# NFA_PUBLIC_ORIGIN=https://your-host
# NFA_PUBLIC_RPC_URL=https://test.rpc.fastnear.com
# NFA_BIND_HOST=0.0.0.0
# NFA_DATA_DIR=/data
# NFA_DURABLE_DATA=1
# Optional paid-service quote policy; enable only with the upgraded registry and
# a READY OutLayer Scout project. Quotes pin runtime/policy versions; the registry enforces minimum margins/caps.
# NFA_SCOUT_POLICY_JSON={"limits":{"max_instructions":1000000000,"max_memory_mb":64,"max_execution_seconds":10},"marginYocto":"10000000000000000000000","maxDepositYocto":"500000000000000000000000"}
# Enable Compare only after the owner configures matching on-chain service policy.
# NFA_COMPARE_POLICY_JSON={"limits":{"max_instructions":1000000000,"max_memory_mb":64,"max_execution_seconds":10},"marginYocto":"10000000000000000000000","maxDepositYocto":"500000000000000000000000"}
# Optional local receipt suite: absolute path to an installed NEAR sandbox executable.
NEAR_SANDBOX_BIN_PATH=
# Worker: set a separate funded, granted account and local key file only for --send.
NFA_WORKER_ID=
NFA_WORKER_KEY_FILE=
EVM_RPC_URL=
EVM_CHAIN_ID=
NFA_SETTLEMENT_REPORTER_ACCOUNT_ID=
NFA_SETTLEMENT_REPORTER_KEY_FILE=

# Optional durable private S3-compatible storage (AWS CLI v2 credential chain).
# NFA_S3_BUCKET=your-private-bucket
# NFA_S3_REGION=us-east-1
# NFA_S3_PREFIX=nfa
# NFA_S3_ENDPOINT=https://your-s3-endpoint
